# Copiar este archivo como .env y completar los valores. El .env NO se versiona.
# Formato: postgresql+asyncpg://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgresql+asyncpg://usuario:contraseña@localhost:5432/libreria

# true muestra en la consola cada consulta SQL emitida (evidencia del caso C-07).
SQL_ECHO=true
